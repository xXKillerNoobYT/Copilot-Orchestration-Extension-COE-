# GitHub Sync Configuration
# Copy this file to .env and fill in your values

# Required: Your GitHub Personal Access Token
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (or public_repo for public repositories only)
GITHUB_TOKEN=your_github_token_here

# Optional: Override repository details
# Defaults to xXKillerNoobYT/Copilot-Orchestration-Extension-COE-
# GITHUB_OWNER=xXKillerNoobYT
# GITHUB_REPO=Copilot-Orchestration-Extension-COE-
