{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Task Markdown",
  "patterns": [
    {
      "include": "#frontmatter"
    },
    {
      "include": "#markdown"
    }
  ],
  "repository": {
    "frontmatter": {
      "patterns": [
        {
          "name": "meta.frontmatter",
          "begin": "^---$",
          "end": "^---$",
          "patterns": [
            {
              "include": "#yaml-fields"
            }
          ]
        }
      ]
    },
    "yaml-fields": {
      "patterns": [
        {
          "name": "meta.taskfield.required",
          "match": "^\\s*(id|title|type|priority|status)(:)(\\s*)(.*)$",
          "captures": {
            "1": {
              "name": "variable.other.field.task"
            },
            "2": {
              "name": "punctuation.separator"
            },
            "4": {
              "name": "string.unquoted"
            }
          }
        },
        {
          "name": "meta.taskfield",
          "match": "^\\s*(dependencies|assignees|labels|estimate|due|github_issue_id|github_issue_url|context_bundle)(:)(\\s*)(.*)$",
          "captures": {
            "1": {
              "name": "variable.other.field"
            },
            "2": {
              "name": "punctuation.separator"
            },
            "4": {
              "name": "string.unquoted"
            }
          }
        },
        {
          "name": "meta.taskfield",
          "match": "^\\s*([a-z_]+)(:)(\\s*)(.*)$",
          "captures": {
            "1": {
              "name": "variable.other.field"
            },
            "2": {
              "name": "punctuation.separator"
            },
            "4": {
              "name": "string.unquoted"
            }
          }
        }
      ]
    },
    "markdown": {
      "patterns": [
        {
          "include": "text.html.markdown"
        },
        {
          "name": "markup.other.taskref",
          "match": "\\b(TASK-[A-Za-z0-9]+-[a-z0-9]+)\\b",
          "captures": {
            "1": {
              "name": "constant.other.taskid"
            }
          }
        },
        {
          "name": "markup.other.issueref",
          "match": "#(\\d+)\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.issueid"
            }
          }
        }
      ]
    }
  },
  "scopeName": "text.task.markdown"
}
