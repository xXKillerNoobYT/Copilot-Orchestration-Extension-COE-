{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build && vite build --ssr",
        "test": "npm run test:all",
        "test:all": "npm run test:context-manager && npm run test:extension && npm run test:report",
        "test:laravel": "php artisan test --parallel --bail",
        "test:context-manager": "echo === Context Manager Tests === && cd context-manager && npm test -- --coverage && cd ..",
        "test:extension": "echo === VS Code Extension Tests === && cd vscode-extension && npm run test:unit -- --coverage && cd ..",
        "test:report": "node scripts/test-reporter.js",
        "test:jest": "jest",
        "test:vscode": "cd vscode-extension && npm run test:jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "validate:prd": "node scripts/validate-prd.cjs",
        "precommit": "npm run validate:prd"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.3.10",
        "@jest/globals": "^29.7.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/jest": "^29.5.14",
        "@types/node": "^25.0.9",
        "@types/ziggy-js": "^1.3.3",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vue/server-renderer": "^3.4.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.6.4",
        "jest": "^29.7.0",
        "laravel-vite-plugin": "^2.0.1",
        "mocha": "^11.7.5",
        "postcss": "^8.4.31",
        "sinon": "^21.0.1",
        "tailwindcss": "^4.1.18",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vue": "^3.4.0",
        "vue-tsc": "^3.2.2"
    },
    "dependencies": {
        "yaml": "^2.8.2",
        "ziggy-js": "^2.6.0"
    }
}
