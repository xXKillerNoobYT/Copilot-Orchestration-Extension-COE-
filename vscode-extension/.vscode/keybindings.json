[
  {
    "command": "copilot-orchestrator.openPlanBuilder",
    "key": "ctrl+shift+p",
    "mac": "cmd+shift+p",
    "when": "!inputFocus"
  },
  {
    "command": "copilot-orchestrator.savePlan",
    "key": "ctrl+s",
    "mac": "cmd+s",
    "when": "editorTextFocus && resourceScheme == 'plan-builder'"
  },
  {
    "command": "copilot-orchestrator.loadPlan",
    "key": "ctrl+o",
    "mac": "cmd+o",
    "when": "!editorTextFocus"
  },
  {
    "command": "copilot-orchestrator.refreshTasks",
    "key": "ctrl+shift+t",
    "mac": "cmd+shift+t",
    "when": "!inputFocus"
  }
]
