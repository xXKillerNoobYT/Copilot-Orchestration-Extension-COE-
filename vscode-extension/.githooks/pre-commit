#!/bin/bash
#
# Git pre-commit hook for command registration validation
#
# This hook runs before each commit to ensure command registrations
# in package.json and code are in sync, preventing "command not found" errors.
#
# To bypass this check (not recommended), use: git commit --no-verify

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running command registration validation...${NC}"

# Check if we're in the vscode-extension directory
if [ ! -f "package.json" ]; then
    echo -e "${YELLOW}⚠️  Not in vscode-extension directory, skipping validation${NC}"
    exit 0
fi

# Check if Node.js is available
if ! command -v node &> /dev/null; then
    echo -e "${YELLOW}⚠️  Node.js not found, skipping validation${NC}"
    exit 0
fi

# Check if npm is available
if ! command -v npm &> /dev/null; then
    echo -e "${YELLOW}⚠️  npm not found, skipping validation${NC}"
    exit 0
fi

# Check if node_modules exists
if [ ! -d "node_modules" ]; then
    echo -e "${YELLOW}⚠️  node_modules not found, run 'npm install' first${NC}"
    echo -e "${YELLOW}⚠️  Skipping validation${NC}"
    exit 0
fi

# Run the command registration validation tests
echo "Validating command registrations..."

# Run just the command registration tests and check exit code
if npm run test:jest -- src/__tests__/command-registration.test.ts --silent > /dev/null 2>&1; then
    echo -e "${GREEN}✓ Command registration validation passed${NC}"
    exit 0
else
    echo -e "${RED}✗ Command registration validation failed${NC}"
    echo ""
    echo -e "${YELLOW}Commands in package.json and code are out of sync!${NC}"
    echo ""
    echo "To see the full details, run:"
    echo "  npm run test:jest -- src/__tests__/command-registration.test.ts"
    echo ""
    echo "To fix the issue:"
    echo "  1. Check the test output for missing/extra commands"
    echo "  2. Add missing commands to package.json or register them in code"
    echo "  3. Run the test again to verify"
    echo ""
    echo "See vscode-extension/COMMAND_REGISTRATION_GUIDE.md for help."
    echo ""
    echo -e "${YELLOW}To commit anyway (NOT recommended), use: git commit --no-verify${NC}"
    exit 1
fi
