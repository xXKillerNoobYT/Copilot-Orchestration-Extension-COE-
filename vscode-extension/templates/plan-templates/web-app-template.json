      "pattern": "Model-View-Controller (MVC)",
      "description": "Three-tier architecture separating data (Model), presentation (View), and business logic (Controller)",
      "components": [
        "Frontend (React/Vue)",
        "Backend API (Node.js/Express)",
        "Database (PostgreSQL/MongoDB)",
        "Authentication Service",
        "File Storage",
        "Cache Layer (Redis)"
      ],
      "rationale": "MVC provides clear separation of concerns, making the codebase maintainable and scalable. Each layer can be developed and tested independently."
    },
