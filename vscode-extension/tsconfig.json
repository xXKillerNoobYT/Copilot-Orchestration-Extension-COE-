{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "outDir": "dist",
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules"
    ]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules", 
    ".vscode-test",
    "dist",
    "**/*.disabled"
  ]
}
